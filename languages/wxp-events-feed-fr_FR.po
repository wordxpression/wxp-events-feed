#. Plugin Name of the plugin
#: wxp-events-feed.php
msgid "WXP Events Feed"
msgstr ""

#. Plugin URI of the plugin
#: wxp-events-feed.php
msgid "https://wxpplugins.com/wxp-events-feed/"
msgstr ""

#. Description of the plugin
#: wxp-events-feed.php
msgid "Show the coming events of another website that runs WXP Local Events, as a list with a block, a shortcode or an Elementor widget."
msgstr "Affiche les prochains événements d'un autre site qui utilise WXP Local Events, sous forme de liste avec un bloc, un shortcode ou un widget Elementor."

#. Author of the plugin
#: wxp-events-feed.php
msgid "Wilko van der Ploeg"
msgstr ""

#. Author URI of the plugin
#: wxp-events-feed.php
msgid "https://wxpplugins.com"
msgstr ""

#: src/Admin/SettingsPage.php:59 src/Admin/SettingsPage.php:133
msgid "Events Feed"
msgstr "Flux d'événements"

#: src/Admin/SettingsPage.php:84
msgid "Settings"
msgstr "Paramètres"

#: src/Admin/SettingsPage.php:95
msgid "Save the address of the events website first."
msgstr "Enregistrez d'abord l'adresse du site des événements."

#. translators: %d: number of events
#: src/Admin/SettingsPage.php:103
msgid "Connected. The events website shares %d coming event."
msgid_plural "Connected. The events website shares %d coming events."
msgstr[0] "Connecté. Le site des événements partage %d événement à venir."
msgstr[1] "Connecté. Le site des événements partage %d événements à venir."

#: src/Admin/SettingsPage.php:120
msgid "The cache is emptied. The next visit fetches the events again."
msgstr "Le cache est vidé. À la prochaine visite, les événements seront de nouveau récupérés."

#: src/Admin/SettingsPage.php:141
msgid "Website with the events"
msgstr "Site avec les événements"

#: src/Admin/SettingsPage.php:144
msgid "The address of the website that runs WXP Local Events. On that website, switch on Events → Settings → Share events."
msgstr "L'adresse du site qui utilise WXP Local Events. Sur ce site, activez Événements → Paramètres → Partager les événements."

#: src/Admin/SettingsPage.php:148
msgid "Refresh the events every (minutes)"
msgstr "Actualiser les événements toutes les (minutes)"

#: src/Admin/SettingsPage.php:151
msgid "The list is kept on this website for this long, so visitors never wait for the other website. If it does not answer, the last list stays visible."
msgstr "La liste est conservée sur ce site pendant cette durée, afin que les visiteurs n'attendent jamais l'autre site. S'il ne répond pas, la dernière liste reste visible."

#: src/Admin/SettingsPage.php:155
msgid "Updates"
msgstr "Mises à jour"

#: src/Admin/SettingsPage.php:158
msgid "Look for new versions of this plugin on GitHub"
msgstr "Rechercher de nouvelles versions de ce plugin sur GitHub"

#: src/Admin/SettingsPage.php:159
msgid "This plugin is not in the WordPress plugin directory. WordPress asks GitHub twice a day if a newer version exists, and sends nothing but the request itself."
msgstr "Ce plugin ne se trouve pas dans le répertoire des plugins WordPress. WordPress demande deux fois par jour à GitHub s'il existe une version plus récente et n'envoie rien d'autre que la requête elle-même."

#: src/Admin/SettingsPage.php:166
msgid "Check and clean up"
msgstr "Vérifier et nettoyer"

#: src/Admin/SettingsPage.php:168
msgid "Test the connection"
msgstr "Tester la connexion"

#: src/Admin/SettingsPage.php:169
msgid "Empty the cache"
msgstr "Vider le cache"

#: src/Admin/SettingsPage.php:172
msgid "Show the events"
msgstr "Afficher les événements"

#: src/Admin/SettingsPage.php:173
msgid "Add the block \"Events feed\" (category WXP Plugins), or the Elementor widget with the same name, or use the shortcode:"
msgstr "Ajoutez le bloc « Flux d'événements » (catégorie WXP Plugins), ou le widget Elementor du même nom, ou utilisez le shortcode :"

#: src/Admin/SettingsPage.php:176
msgid "number of events, 1 to 20 (default 5)."
msgstr "nombre d'événements, de 1 à 20 (5 par défaut)."

#: src/Admin/SettingsPage.php:177
msgid "category slugs of the events website, comma separated."
msgstr "slugs des catégories du site des événements, séparés par des virgules."

#: src/Admin/SettingsPage.php:178
msgid "yes or no."
msgstr "oui ou non."

#: src/Admin/SettingsPage.php:179
msgid "thumbnail or medium."
msgstr "thumbnail ou medium."

#: src/Admin/SettingsPage.php:180
msgid "\"site\" formats dates like this website does (default), \"source\" uses the text of the events website."
msgstr "« site » met les dates en forme comme ce site (par défaut), « source » utilise le texte du site des événements."

#: src/Admin/SettingsPage.php:181
msgid "h2 to h6, or p, for the event titles (default h3)."
msgstr "h2 à h6, ou p, pour les titres des événements (h3 par défaut)."

#: src/Admin/SettingsPage.php:182
msgid "an extra CSS class."
msgstr "une classe CSS supplémentaire."

#: src/Admin/SettingsPage.php:209
msgid "You are not allowed to do this."
msgstr "Vous n'êtes pas autorisé à faire cela."

