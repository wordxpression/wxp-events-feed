msgstr "Affiche les prochains événements d'un autre site qui utilise WXP Local Events."

#: wxp-events-feed.php:45
msgid "WXP Events Feed is not loaded: it needs PHP 8.1 or higher."
msgstr "WXP Events Feed n'est pas chargé : PHP 8.1 ou supérieur est requis."

#: wxp-events-feed.php:48
msgid "WXP Events Feed is not loaded: another copy of this plugin is already active. Deactivate one of them."
msgstr "WXP Events Feed n'est pas chargé : une autre copie de ce plugin est déjà active. Désactivez-en une."

