#. Plugin Name of the plugin
#: wxp-events-feed.php
msgid "WXP Events Feed"
msgstr ""

#. Plugin URI of the plugin
#: wxp-events-feed.php
msgid "https://wxpplugins.com/wxp-events-feed/"
msgstr ""

#. Description of the plugin
#: wxp-events-feed.php
msgid "Show the coming events of another website that runs WXP Local Events, as a list with a block, a shortcode or an Elementor widget."
msgstr "Zeigt die kommenden Veranstaltungen einer anderen Website, auf der WXP Local Events läuft, als Liste mit einem Block, einem Shortcode oder einem Elementor-Widget."

#. Author of the plugin
#: wxp-events-feed.php
msgid "Wilko van der Ploeg"
msgstr ""

#. Author URI of the plugin
#: wxp-events-feed.php
msgid "https://wxpplugins.com"
msgstr ""

#: src/Admin/SettingsPage.php:60 src/Admin/SettingsPage.php:137
msgid "Events Feed"
msgstr "Veranstaltungs-Feed"

#: src/Admin/SettingsPage.php:85
msgid "Settings"
msgstr "Einstellungen"

#: src/Admin/SettingsPage.php:98
msgid "Fill in the address of the events website first."
msgstr "Tragen Sie zuerst die Adresse der Veranstaltungswebsite ein."

#. translators: %d: number of events
#: src/Admin/SettingsPage.php:106
msgid "Connected. The events website shares %d coming event."
msgid_plural "Connected. The events website shares %d coming events."
msgstr[0] "Verbunden. Die Veranstaltungswebsite teilt %d kommende Veranstaltung."
msgstr[1] "Verbunden. Die Veranstaltungswebsite teilt %d kommende Veranstaltungen."

#: src/Admin/SettingsPage.php:124
msgid "The cache is emptied. The next visit fetches the events again."
msgstr "Der Cache wurde geleert. Beim nächsten Besuch werden die Veranstaltungen neu geladen."

#: src/Admin/SettingsPage.php:145
msgid "Website with the events"
msgstr "Website mit den Veranstaltungen"

#: src/Admin/SettingsPage.php:148
msgid "The address of the website that runs WXP Local Events. On that website, switch on Events → Settings → Share events."
msgstr "Die Adresse der Website, auf der WXP Local Events läuft. Aktivieren Sie auf dieser Website Veranstaltungen → Einstellungen → Veranstaltungen teilen."

#: src/Admin/SettingsPage.php:152
msgid "Refresh the events every (minutes)"
msgstr "Veranstaltungen aktualisieren alle (Minuten)"

#: src/Admin/SettingsPage.php:155
msgid "The list is kept on this website for this long, so visitors never wait for the other website. If it does not answer, the last list stays visible."
msgstr "Die Liste wird so lange auf dieser Website gespeichert, damit Besucher nie auf die andere Website warten müssen. Antwortet diese nicht, bleibt die letzte Liste sichtbar."

#: src/Admin/SettingsPage.php:159
msgid "Updates"
msgstr "Updates"

#: src/Admin/SettingsPage.php:162
msgid "Look for new versions of this plugin on GitHub"
msgstr "Auf GitHub nach neuen Versionen dieses Plugins suchen"

#: src/Admin/SettingsPage.php:163
msgid "This plugin is not in the WordPress plugin directory. WordPress asks GitHub twice a day if a newer version exists, and sends nothing but the request itself."
msgstr "Dieses Plugin ist nicht im WordPress-Plugin-Verzeichnis. WordPress fragt zweimal täglich bei GitHub nach einer neueren Version und sendet nichts außer der Anfrage selbst."

#: src/Admin/SettingsPage.php:170
msgid "Test the connection"
msgstr "Verbindung testen"

#: src/Admin/SettingsPage.php:174
msgid "Check and clean up"
msgstr "Prüfen und aufräumen"

#: src/Admin/SettingsPage.php:176
msgid "Empty the cache"
msgstr "Cache leeren"

#: src/Admin/SettingsPage.php:179
msgid "Show the events"
msgstr "Die Veranstaltungen anzeigen"

#: src/Admin/SettingsPage.php:180
msgid "Add the block \"Events feed\" (category WXP Plugins), or the Elementor widget with the same name, or use the shortcode:"
msgstr "Fügen Sie den Block „Veranstaltungs-Feed“ (Kategorie WXP Plugins) oder das Elementor-Widget mit demselben Namen hinzu, oder verwenden Sie den Shortcode:"

#: src/Admin/SettingsPage.php:183
msgid "number of events, 1 to 20 (default 5)."
msgstr "Anzahl der Veranstaltungen, 1 bis 20 (Standard 5)."

#: src/Admin/SettingsPage.php:184
msgid "category slugs of the events website, comma separated."
msgstr "Kategorie-Slugs der Veranstaltungswebsite, durch Kommas getrennt."

#: src/Admin/SettingsPage.php:185
msgid "yes or no."
msgstr "ja oder nein."

#: src/Admin/SettingsPage.php:186
msgid "thumbnail or medium."
msgstr "thumbnail oder medium."

#: src/Admin/SettingsPage.php:187
msgid "\"site\" formats dates like this website does (default), \"source\" uses the text of the events website."
msgstr "„site“ formatiert Datumsangaben wie diese Website (Standard), „source“ verwendet den Text der Veranstaltungswebsite."

#: src/Admin/SettingsPage.php:188
msgid "h2 to h6, or p, for the event titles (default h3)."
msgstr "h2 bis h6 oder p für die Titel der Veranstaltungen (Standard h3)."

#: src/Admin/SettingsPage.php:189
msgid "an extra CSS class."
msgstr "eine zusätzliche CSS-Klasse."

#: src/Admin/SettingsPage.php:217
msgid "You are not allowed to do this."
msgstr "Sie sind nicht berechtigt, dies zu tun."

#: src/Admin/SettingsPage.php:257
msgid "The address is not saved yet: press Save changes."
msgstr "Die Adresse ist noch nicht gespeichert: Klicken Sie auf „Änderungen speichern“."

