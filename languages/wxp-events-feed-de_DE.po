msgstr "Linien zwischen Veranstaltungen"

#: src/Elementor/FeedWidget.php:220
msgid "Date colour"
msgstr "Farbe des Datums"

#: src/Elementor/FeedWidget.php:230
msgid "Title colour"
msgstr "Farbe des Titels"

#: src/Elementor/FeedWidget.php:240
