msgstr "Aantal evenementen"

#: src/Elementor/FeedWidget.php:94 assets/block/build/index.js:1
msgid "Categories"
msgstr "Categorieën"

#: src/Elementor/FeedWidget.php:97 assets/block/build/index.js:1
msgid "Category slugs of the events website, comma separated. Empty shows all events."
msgstr "Categorie-slugs van de evenementenwebsite, gescheiden door komma's. Leeg toont alle evenementen."

#: src/Elementor/FeedWidget.php:103 assets/block/build/index.js:1
msgid "Image"
msgstr "Afbeelding"

#: src/Elementor/FeedWidget.php:112 assets/block/build/index.js:1
msgid "Image size"
msgstr "Afbeeldingsgrootte"

#: src/Elementor/FeedWidget.php:115 assets/block/build/index.js:1
msgid "Small"
msgstr "Klein"

#: src/Elementor/FeedWidget.php:116 assets/block/build/index.js:1
msgid "Medium"
msgstr "Gemiddeld"

#: src/Elementor/FeedWidget.php:125 assets/block/build/index.js:1
msgid "Short description"
msgstr "Korte omschrijving"

#: src/Elementor/FeedWidget.php:134 assets/block/build/index.js:1
msgid "Time"
msgstr "Tijd"

#: src/Elementor/FeedWidget.php:143 assets/block/build/index.js:1
msgid "Date format"
msgstr "Datumnotatie"

#: src/Elementor/FeedWidget.php:146 assets/block/build/index.js:1
msgid "Like this website"
msgstr "Zoals deze website"

#: src/Elementor/FeedWidget.php:147 assets/block/build/index.js:1
msgid "Like the events website"
msgstr "Zoals de evenementenwebsite"

#: src/Elementor/FeedWidget.php:155 assets/block/build/index.js:1
msgid "Title element"
msgstr "Titelelement"

#: src/Elementor/FeedWidget.php:174
msgid "Style"
msgstr "Stijl"

#: src/Elementor/FeedWidget.php:181
msgid "Image width"
msgstr "Breedte van de afbeelding"

#: src/Elementor/FeedWidget.php:198
msgid "Space between events"
msgstr "Ruimte tussen evenementen"

#: src/Elementor/FeedWidget.php:210
msgid "Lines between events"
msgstr "Lijnen tussen evenementen"

#: src/Elementor/FeedWidget.php:220
msgid "Date colour"
msgstr "Kleur van de datum"

#: src/Elementor/FeedWidget.php:230
msgid "Title colour"
msgstr "Kleur van de titel"

#: src/Elementor/FeedWidget.php:240
msgid "Description colour"
msgstr "Kleur van de omschrijving"

#: src/Elementor/FeedWidget.php:251
msgid "Date"
msgstr "Datum"

#: src/Elementor/FeedWidget.php:259
msgid "Title"
msgstr "Titel"

#: src/Elementor/FeedWidget.php:267
msgid "Description"
msgstr "Omschrijving"

#: src/Feed/FeedClient.php:115
msgid "No events website is set yet. Fill in its address under Settings → Events Feed."
msgstr "Er is nog geen evenementenwebsite ingesteld. Vul het adres in onder Instellingen → Evenementenfeed."

#. translators: %s: technical reason
#: src/Feed/FeedClient.php:118
msgid "The events website could not be reached (%s)."
msgstr "De evenementenwebsite kon niet worden bereikt (%s)."

#. translators: %s: HTTP status code
#: src/Feed/FeedClient.php:121
msgid "The events website answered with status %s."
msgstr "De evenementenwebsite antwoordde met status %s."

#: src/Feed/FeedClient.php:123
msgid "The events website has not switched on sharing. On that website, go to Events → Settings → Share events."
msgstr "De evenementenwebsite heeft delen niet aangezet. Ga op die website naar Evenementen → Instellingen → Evenementen delen."

#: src/Feed/FeedClient.php:126
msgid "The address does not give an event feed. Is WXP Local Events (version 0.14 or newer) active on that website?"
msgstr "Het adres geeft geen evenementenfeed. Is WXP Local Events (versie 0.14 of nieuwer) actief op die website?"

#: src/Feed/FeedClient.php:128
msgid "The events website uses a newer feed than this plugin understands. Update WXP Events Feed."
msgstr "De evenementenwebsite gebruikt een nieuwere feed dan deze plugin begrijpt. Werk WXP Events Feed bij."

#: src/Feed/FeedClient.php:130
msgid "The events website did not answer a moment ago. It is tried again soon."
msgstr "De evenementenwebsite antwoordde zojuist niet. Er wordt binnenkort opnieuw geprobeerd."

#: src/Feed/FeedClient.php:132
msgid "The events could not be loaded."
msgstr "De evenementen konden niet worden geladen."

#: src/Render/ListRenderer.php:39
msgid "There are no upcoming events at the moment."
msgstr "Er zijn op dit moment geen komende evenementen."

#: src/Render/ListRenderer.php:79
msgid "(opens in a new tab)"
msgstr "(opent in een nieuw tabblad)"

#: src/Update/GitHubUpdater.php:102
msgid "Show the coming events of another website that runs WXP Local Events."
msgstr "Toon de komende evenementen van een andere website waarop WXP Local Events draait."

#: wxp-events-feed.php:45
msgid "WXP Events Feed is not loaded: it needs PHP 8.1 or higher."
msgstr "WXP Events Feed is niet geladen: PHP 8.1 of hoger is nodig."

#: wxp-events-feed.php:48
msgid "WXP Events Feed is not loaded: another copy of this plugin is already active. Deactivate one of them."
msgstr "WXP Events Feed is niet geladen: er is al een andere kopie van deze plugin actief. Deactiveer er een."

#. translators: %s: technical error message
#: wxp-events-feed.php:52
msgid "WXP Events Feed could not start: %s"
msgstr "WXP Events Feed kon niet starten: %s"

